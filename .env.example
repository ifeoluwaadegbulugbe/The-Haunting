# THE HAUNTING — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file matching .env* (except this example).

# ─── AI provider ────────────────────────────────────────────────────────────
# Which provider to use. Supported values: gemini | groq
AI_PROVIDER=gemini

# The exact model name. Examples:
#   gemini-1.5-flash   (Gemini free tier)
#   llama3-8b-8192     (Groq free tier)
AI_MODEL=gemini-1.5-flash

# Your API key. Never prefix with NEXT_PUBLIC_ — this must stay server-side.
AI_API_KEY=your-api-key-here

# Set to 1 to force the deterministic MockProvider (no network calls).
# Use this in automated tests and as an emergency fallback.
AI_MOCK=0
